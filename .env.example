GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Payload CMS
PAYLOAD_SECRET=
PREVIEW_SECRET=
# Prefer Neon pooled URL (*-pooler.*). Direct 5432 often times out.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Public origin. On Vercel this must be https://genesisintegrativemed.com (never localhost).
NEXT_PUBLIC_SITE_URL=https://genesisintegrativemed.com
# Local: http://localhost:3000
# Vercel Production / Preview: the public https origin (never localhost).
NEXT_PUBLIC_SERVER_URL=https://genesisintegrativemed.com

# Optional. Without this, Payload stores media locally at /media (404s on Vercel).
BLOB_READ_WRITE_TOKEN=

# Optional local admin bootstrap (npm run cms:ensure-admin)
# CMS_ADMIN_EMAIL=
# CMS_ADMIN_PASSWORD=
